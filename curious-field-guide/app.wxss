/* 好奇图鉴 - 全局样式表（手账素描风） */

/* 1. CSS 变量：手账色彩与质感系统 */
page {
  /* 纸张与铅笔 */
  --paper: #faf8f3;
  --pencil: #3a3a3a;
  --gray: #888888;
  --light-gray: #999999;
  --cream: #f5f5f0;
  --white: #ffffff;

  /* 蜡笔功能色 */
  --green: #4a9b5c;
  --green-bg: rgba(74, 155, 92, 0.12);
  --orange: #c9a227;
  --orange-bg: rgba(201, 162, 39, 0.12);
  --purple: #7c5bbf;
  --purple-bg: rgba(124, 91, 191, 0.12);
  --blue: #4a7c9b;
  --blue-bg: rgba(74, 124, 155, 0.12);
  --red: #b85450;
  --red-bg: rgba(184, 84, 80, 0.12);

  /* 字号 */
  --font-hand: 'Courier New', Menlo, Monaco, monospace;

  --text-h1: 52rpx;
  --text-h2: 44rpx;
  --text-h3: 36rpx;
  --text-h4: 28rpx;
  --text-body: 26rpx;
  --text-caption: 24rpx;
  --text-small: 22rpx;
  --text-badge: 22rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 40rpx;
  --space-xxl: 48rpx;

  /* 边框：粗线 + 不对称圆角 */
  --border-width: 5rpx;
  --border-width-lg: 6rpx;
  --border-width-sm: 4rpx;
  --border-color: #3a3a3a;
  --radius-lg: 8rpx 48rpx 16rpx 40rpx;
  --radius-md: 8rpx 32rpx 16rpx 24rpx;
  --radius-sm: 12rpx 6rpx 16rpx 10rpx;
  --radius-pill: 32rpx 12rpx 28rpx 16rpx;
  --radius-circle: 50%;

  /* 动画 */
  --transition-fast: 0.15s ease;

  font-family: var(--font-hand);
  background-color: var(--paper);
  color: var(--pencil);
  box-sizing: border-box;
}

/* 2. 页面容器 */
.page-container {
  min-height: 100vh;
  padding: var(--space-xxl) var(--space-xl);
  box-sizing: border-box;
  background-color: var(--paper);
}

/* 3. 通用卡片：双层边框模拟手绘厚度 */
.card {
  position: relative;
  background-color: var(--white);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--space-md);
}

.card::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx 30rpx 18rpx 22rpx;
  pointer-events: none;
  opacity: 0.08;
}

/* 4. 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-family: var(--font-hand);
  transition: transform var(--transition-fast);
}

.btn:active {
  transform: rotate(1deg) scale(0.98);
}

.btn-primary {
  height: 88rpx;
  background-color: var(--pencil);
  color: var(--paper);
  font-size: 30rpx;
}

.btn-primary:active {
  background-color: var(--pencil);
}

.btn-secondary {
  height: 88rpx;
  background-color: var(--white);
  color: var(--pencil);
  font-size: 30rpx;
}

.btn-secondary:active {
  background-color: var(--cream);
}

.btn-disabled {
  opacity: 0.5;
}

/* 5. 文字层级 */
.text-page-title {
  font-size: var(--text-h1);
  font-weight: 700;
  line-height: 72rpx;
  color: var(--pencil);
  transform: rotate(-1deg);
  transform-origin: left center;
}

.text-page-subtitle {
  font-size: var(--text-body);
  line-height: 40rpx;
  color: var(--gray);
}

.text-section-title {
  font-size: var(--text-h3);
  font-weight: 700;
  line-height: 52rpx;
  color: var(--pencil);
  transform: rotate(-0.5deg);
  transform-origin: left center;
}

.text-card-title {
  font-size: var(--text-h4);
  font-weight: 700;
  line-height: 40rpx;
  color: var(--pencil);
}

.text-body {
  font-size: var(--text-body);
  line-height: 40rpx;
  color: var(--pencil);
}

.text-caption {
  font-size: var(--text-caption);
  line-height: 36rpx;
  color: var(--gray);
}

.text-small {
  font-size: var(--text-small);
  line-height: 32rpx;
  color: var(--light-gray);
}

.text-hint {
  font-size: var(--text-caption);
  line-height: 36rpx;
  color: var(--light-gray);
  font-style: italic;
}

/* 6. 标签 / 胶囊（蜡笔色块） */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border: var(--border-width-sm) solid;
  border-radius: var(--radius-pill);
  font-size: var(--text-badge);
  font-weight: 700;
  font-family: var(--font-hand);
  line-height: 1;
}

.tag-green {
  border-color: var(--green);
  background-color: var(--green-bg);
  color: var(--green);
  transform: rotate(1deg);
}

.tag-orange {
  border-color: var(--orange);
  background-color: var(--orange-bg);
  color: var(--orange);
  transform: rotate(-1deg);
}

.tag-purple {
  border-color: var(--purple);
  background-color: var(--purple-bg);
  color: var(--purple);
  transform: rotate(0.5deg);
}

.tag-blue {
  border-color: var(--blue);
  background-color: var(--blue-bg);
  color: var(--blue);
  transform: rotate(-0.5deg);
}

.tag-red {
  border-color: var(--red);
  background-color: var(--red-bg);
  color: var(--red);
  transform: rotate(1deg);
}

/* 7. 通用间距工具类 */
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mt-xl { margin-top: var(--space-xl); }

.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }
.mb-xl { margin-bottom: var(--space-xl); }

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 8. 手写图标容器 */
.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--border-width) solid var(--border-color);
  border-radius: 12rpx 20rpx 16rpx 16rpx;
  background-color: var(--cream);
  transform: rotate(-2deg);
}

/* 9. slogan 虚线框 */
.slogan-box {
  border: 4rpx dashed var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--space-sm) var(--space-md);
  text-align: center;
}
