/* 隐私政策弹窗组件样式 */

.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.privacy-container {
  width: 560rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

.privacy-desc {
  margin-bottom: var(--spacing-md);
}

.privacy-desc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.privacy-item {
  font-size: 26rpx;
  line-height: 42rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.privacy-link {
  font-size: 26rpx;
  color: var(--color-primary);
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.privacy-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.privacy-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 0;
  margin: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-primary {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.privacy-btn-secondary {
  background-color: transparent;
  color: var(--color-text-secondary);
}
