/* 隐私政策弹窗组件样式（手账风格） */

.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(58, 58, 58, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.privacy-container {
  position: relative;
  width: 580rpx;
  background-color: var(--white);
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: 10rpx 36rpx 18rpx 30rpx;
  padding: var(--space-lg);
  box-sizing: border-box;
}

.privacy-container::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 14rpx 34rpx 22rpx 28rpx;
  pointer-events: none;
  opacity: 0.1;
}

.privacy-title {
  font-size: var(--text-h3);
  font-weight: 700;
  text-align: center;
  color: var(--pencil);
  margin-bottom: var(--space-md);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
}

.privacy-desc {
  margin-bottom: var(--space-md);
}

.privacy-desc-title {
  display: block;
  font-size: var(--text-body);
  font-weight: 700;
  color: var(--pencil);
  margin-bottom: var(--space-sm);
  font-family: var(--font-hand);
}

.privacy-item {
  font-size: var(--text-caption);
  line-height: 40rpx;
  color: var(--gray);
  margin-bottom: var(--space-xs);
  font-family: var(--font-hand);
}

.privacy-link {
  font-size: var(--text-caption);
  color: var(--pencil);
  text-align: center;
  margin-bottom: var(--space-md);
  text-decoration: underline;
  font-family: var(--font-hand);
}

.privacy-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.privacy-btn {
  height: 88rpx;
  line-height: 88rpx;
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 700;
  font-family: var(--font-hand);
  text-align: center;
  padding: 0;
  margin: 0;
  transition: transform var(--transition-fast);
}

.privacy-btn:active {
  transform: rotate(1deg) scale(0.98);
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-primary {
  background-color: var(--pencil);
  color: var(--paper);
}

.privacy-btn-secondary {
  background-color: var(--white);
  color: var(--pencil);
}

.privacy-btn-secondary:active {
  background-color: var(--cream);
}
