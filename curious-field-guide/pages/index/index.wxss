/* 首页样式（手账风格） */

.index-page {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* 拍照入口 */
.camera-entry-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
}

.camera-entry {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 400rpx;
  padding: var(--space-lg) var(--space-md);
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.camera-entry::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx 46rpx 18rpx 38rpx;
  pointer-events: none;
  opacity: 0.1;
}

.camera-entry:active {
  transform: rotate(-1deg) scale(1.01);
}

.camera-entry-disabled {
  opacity: 0.6;
}

.camera-icon-wrap {
  width: 132rpx;
  height: 132rpx;
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: 50%;
  background: var(--pencil);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-2deg);
  margin-bottom: var(--space-md);
}

.camera-icon {
  font-size: 64rpx;
  color: var(--paper);
}

.camera-title {
  font-size: var(--text-h3);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
}

.camera-desc {
  font-size: var(--text-caption);
  color: var(--gray);
  margin-top: var(--space-sm);
  text-align: center;
}

/* 最近发现 */
.recent-section {
  width: 100%;
  margin-top: var(--space-lg);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.section-more {
  font-size: var(--text-caption);
  color: var(--gray);
  font-family: var(--font-hand);
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.recent-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border: var(--border-width) solid var(--border-color);
  border-radius: 6rpx 28rpx 10rpx 24rpx;
  background: var(--white);
  transition: transform var(--transition-fast);
}

.recent-item::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 10rpx 26rpx 14rpx 22rpx;
  pointer-events: none;
  opacity: 0.08;
}

.recent-item:active {
  transform: rotate(-1deg) translateX(2rpx);
}

.recent-thumb {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--border-width) solid var(--border-color);
  border-radius: 10rpx 20rpx 12rpx 18rpx;
  background: var(--cream);
  transform: rotate(-2deg);
  flex-shrink: 0;
}

.recent-emoji {
  font-size: 48rpx;
}

/* 实拍缩略图：有实拍图时铺满手绘边框缩略框 */
.recent-thumb-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

/* 分类手绘图标（无实拍图时兜底） */
.recent-thumb-icon {
  width: 80%;
  height: 80%;
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.recent-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.recent-name {
  font-size: var(--text-h4);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.recent-tags {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.recent-meta {
  font-size: var(--text-small);
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--space-xl);
  padding: var(--space-lg);
  border: var(--border-width) dashed var(--border-color);
  border-radius: var(--radius-md);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-sm);
  transform: rotate(-3deg);
}
