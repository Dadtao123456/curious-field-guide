<!-- 好奇图鉴 - 手动搜索页（手账风格） -->
<!-- 数据流：输入关键词 → 搜索 → 候选列表 → 点击进结果页确认 -->

<view class="page-container search-page">
  <!-- 搜索区 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="物种名称或外观特征"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <view class="btn btn-primary search-btn {{searching ? 'btn-disabled' : ''}}" bindtap="onSearch">
      {{searching ? '...' : '搜索'}}
    </view>
  </view>

  <!-- 初始态 -->
  <view class="search-hint-block" wx:if="{{!searched}}">
    <image class="search-hint-img" src="/images/icons/icon-search.png" mode="aspectFit" />
    <text class="text-hint">试试：大嘴乌鸦 / 月季 / 凤蝶</text>
  </view>

  <!-- 无结果态 -->
  <view class="search-hint-block" wx:if="{{searched && results.length === 0}}">
    <image class="search-hint-img" src="/images/icons/icon-empty.png" mode="aspectFit" />
    <text class="text-hint">未找到相关物种，试试完整的物种名，如「大嘴乌鸦」</text>
  </view>

  <!-- 候选列表 -->
  <view class="candidate-list" wx:if="{{results.length > 0}}">
    <view
      wx:for="{{results}}"
      wx:key="speciesKey"
      class="candidate-item"
      bindtap="onCandidateTap"
      data-index="{{index}}"
    >
      <view class="candidate-thumb">
        <image class="candidate-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="candidate-info">
        <text class="candidate-name">{{item.name}}</text>
        <text class="candidate-latin">{{item.latinName}}</text>
        <text class="candidate-desc">{{item.description}}</text>
      </view>
      <text class="candidate-arrow">›</text>
    </view>
  </view>
</view>
