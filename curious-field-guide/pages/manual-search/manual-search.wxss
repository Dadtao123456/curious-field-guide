/* 手动搜索页样式（手账风格） */

.search-bar {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-md);
  border: var(--border-width) solid var(--border-color);
  border-radius: 16rpx 8rpx 20rpx 12rpx;
  background: var(--white);
  font-size: var(--text-body);
  font-family: var(--font-hand);
  color: var(--pencil);
  box-sizing: border-box;
}

.search-placeholder {
  color: var(--light-gray);
  font-style: italic;
}

.search-btn {
  width: 140rpx;
  height: 80rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 提示块（初始态 / 无结果态） */
.search-hint-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-xxl);
  padding: var(--space-xl) var(--space-lg);
  border: var(--border-width) dashed var(--border-color);
  border-radius: var(--radius-md);
  text-align: center;
}

.search-hint-icon {
  font-size: 80rpx;
  transform: rotate(-3deg);
}

/* 候选列表 */
.candidate-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.candidate-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border: var(--border-width) solid var(--border-color);
  border-radius: 6rpx 28rpx 10rpx 24rpx;
  background: var(--white);
  transition: transform var(--transition-fast);
}

.candidate-item:active {
  transform: rotate(-1deg) translateX(2rpx);
}

.candidate-thumb {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--border-width) solid var(--border-color);
  border-radius: 10rpx 20rpx 12rpx 18rpx;
  background: var(--cream);
  transform: rotate(-2deg);
  flex-shrink: 0;
}

.candidate-emoji {
  font-size: 48rpx;
}

/* 分类手绘图标（搜索候选缩略图） */
.candidate-icon {
  width: 80%;
  height: 80%;
}

.candidate-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.candidate-name {
  font-size: var(--text-h4);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.candidate-latin {
  font-size: var(--text-small);
  color: var(--gray);
  font-style: italic;
  font-family: var(--font-hand);
}

.candidate-desc {
  font-size: var(--text-small);
  color: var(--gray);
  font-family: var(--font-hand);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.candidate-arrow {
  font-size: 40rpx;
  color: var(--light-gray);
  font-family: var(--font-hand);
  flex-shrink: 0;
}
