<!-- 好奇图鉴 - 我的页（手账风格） -->
<!-- 数据流：onShow 加载收藏数据 → 统计/徽章渲染 → 菜单跳转或占位提示 -->

<view class="page-container profile-page">
  <!-- 用户信息区 -->
  <view class="user-block">
    <view class="avatar">
      <text class="avatar-emoji">{{avatarEmoji}}</text>
    </view>
    <view class="user-info">
      <text class="user-nickname">{{nickname}}</text>
      <text class="user-join" wx:if="{{joinDays > 0}}">加入好奇图鉴 {{joinDays}} 天</text>
      <text class="user-join" wx:else>还没有发现，去拍第一张吧</text>
    </view>
  </view>

  <!-- 三项统计 -->
  <view class="stats-row mt-lg">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">发现物种</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{categoryCount}}</text>
      <text class="stat-label">覆盖类别</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <!-- 里程碑徽章 -->
  <view class="badge-section mt-xl">
    <view class="badge-header">
      <text class="text-section-title">里程碑</text>
      <text class="badge-progress">{{unlockedCount}} / {{badges.length}}</text>
    </view>
    <view class="badge-grid">
      <view
        wx:for="{{badges}}"
        wx:key="id"
        class="badge-cell {{item.unlocked ? '' : 'badge-locked'}}"
      >
        <text class="badge-emoji">{{item.emoji}}</text>
        <text class="badge-name">{{item.name}}</text>
        <text class="badge-target">{{item.unlocked ? '已解锁' : item.progress + '/' + item.target}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单区 -->
  <view class="menu-list mt-xl">
    <view class="menu-item" bindtap="onExportHandbook">
      <text class="menu-title">导出观察手册</text>
      <view class="menu-right">
        <text class="menu-badge">PDF</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onPrivacySetting">
      <text class="menu-title">隐私设置</text>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-title">关于好奇图鉴</text>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部 slogan -->
  <view class="profile-slogan mt-xl">
    <text class="text-hint">珍惜你的每一次好奇心</text>
  </view>
</view>
