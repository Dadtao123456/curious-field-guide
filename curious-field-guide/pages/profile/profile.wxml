<!-- 好奇图鉴 - 我的页（手账风格） -->
<!-- 数据流：onShow 加载收藏数据 → 统计/徽章渲染 → 菜单跳转或占位提示 -->

<view class="page-container profile-page">
  <!-- 用户信息区（点击进入编辑资料） -->
  <view class="user-block" bindtap="onEditProfile">
    <view class="avatar">
      <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-img" />
      <text wx:else class="avatar-emoji">{{avatarEmoji}}</text>
    </view>
    <view class="user-info">
      <text class="user-nickname">{{nickname}}</text>
      <text class="user-join" wx:if="{{joinDays > 0}}">加入好奇图鉴 {{joinDays}} 天</text>
      <text class="user-join" wx:else>还没有发现，去拍第一张吧</text>
    </view>
    <text class="user-edit-hint">编辑 ›</text>
  </view>

  <!-- 三项统计 -->
  <view class="stats-row mt-lg">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">发现物种</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{categoryCount}}</text>
      <text class="stat-label">覆盖类别</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <!-- 里程碑徽章 -->
  <view class="badge-section mt-xl">
    <view class="badge-header">
      <text class="text-section-title">里程碑</text>
      <text class="badge-progress">{{unlockedCount}} / {{badges.length}}</text>
    </view>
    <view class="badge-grid">
      <view
        wx:for="{{badges}}"
        wx:key="id"
        class="badge-cell {{item.unlocked ? '' : 'badge-locked'}}"
        bindtap="onBadgeTap"
        data-index="{{index}}"
      >
        <text class="badge-emoji {{item.unlocked ? '' : 'badge-question'}}">{{item.unlocked ? item.emoji : '?'}}</text>
        <text class="badge-name">{{item.unlocked ? item.name : '???'}}</text>
        <text class="badge-target">{{item.unlocked ? '已解锁' : item.progress + '/' + item.target}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单区 -->
  <view class="menu-list mt-xl">
    <view class="menu-item" bindtap="onExportHandbook">
      <text class="menu-title">导出观察手册</text>
      <view class="menu-right">
        <text class="menu-badge">PDF</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onPrivacySetting">
      <text class="menu-title">隐私设置</text>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-title">关于好奇图鉴</text>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部 slogan -->
  <view class="profile-slogan mt-xl">
    <text class="text-hint">珍惜你的每一次好奇心</text>
  </view>
</view>

<!-- 徽章详情卡片 -->
<view class="badge-modal-mask" wx:if="{{showBadgeModal}}" bindtap="onCloseBadgeModal">
  <view class="badge-modal" catchtap="onModalContentTap">
    <text class="badge-modal-emoji">{{activeBadge.emoji}}</text>
    <text class="badge-modal-name">{{activeBadge.name}}</text>
    <text class="badge-modal-desc">{{activeBadge.description}}</text>
    <text class="badge-modal-status">🎉 已解锁</text>
    <view class="btn btn-secondary badge-modal-btn" bindtap="onCloseBadgeModal">知道了</view>
  </view>
</view>

<!-- 编辑资料弹层（微信官方头像昵称填写能力） -->
<view class="badge-modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal">
  <view class="badge-modal" catchtap="onModalContentTap">
    <text class="edit-title">编辑资料</text>
    <!-- 头像：button open-type="chooseAvatar" 调起微信官方选头像 -->
    <button class="edit-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{draftAvatarUrl}}" src="{{draftAvatarUrl}}" mode="aspectFill" class="edit-avatar-img" />
      <text wx:else class="edit-avatar-emoji">{{avatarEmoji}}</text>
    </button>
    <text class="edit-hint">点头像可更换</text>
    <!-- 昵称：type="nickname" 自带微信昵称联想键盘 -->
    <input
      class="edit-nickname-input"
      type="nickname"
      value="{{draftNickname}}"
      placeholder="给自己起个名字"
      maxlength="20"
      bindinput="onNicknameInput"
    />
    <view class="edit-actions">
      <view class="btn btn-secondary edit-btn" bindtap="onCloseEditModal">取消</view>
      <view class="btn btn-primary edit-btn" bindtap="onSaveProfile">保存</view>
    </view>
  </view>
</view>
