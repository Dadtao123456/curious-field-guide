/* 我的页样式（手账风格） */

/* 用户信息区 */
.user-block {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: 50%;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 56rpx;
}

/* 用户头像图片：铺满圆形手绘边框 */
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 用户信息区右侧的编辑入口 */
.user-edit-hint {
  margin-left: auto;
  font-size: var(--text-caption);
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 编辑资料弹层 */
.edit-title {
  font-size: var(--text-h2);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

/* chooseAvatar 按钮：去掉默认按钮样式，只保留圆形头像 */
.edit-avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: 50%;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  overflow: hidden;
}

.edit-avatar-btn::after {
  border: none;
}

.edit-avatar-img {
  width: 100%;
  height: 100%;
}

.edit-avatar-emoji {
  font-size: 64rpx;
}

.edit-hint {
  font-size: var(--text-caption);
  color: var(--gray);
  font-family: var(--font-hand);
}

.edit-nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-md);
  border: var(--border-width) solid var(--border-color);
  border-radius: 10rpx 24rpx 14rpx 20rpx;
  box-sizing: border-box;
  font-size: var(--text-body);
  color: var(--pencil);
  font-family: var(--font-hand);
  text-align: center;
}

.edit-actions {
  width: 100%;
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.edit-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.user-nickname {
  font-size: var(--text-h2);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
  transform-origin: left center;
}

.user-join {
  font-size: var(--text-caption);
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 三项统计 */
.stats-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-top: 4rpx dashed var(--border-color);
  border-bottom: 4rpx dashed var(--border-color);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-divider {
  width: 4rpx;
  height: 64rpx;
  border-left: 4rpx dashed #ddd;
}

.stat-num {
  font-size: var(--text-h1);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  line-height: 1.2;
}

.stat-label {
  font-size: var(--text-small);
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 里程碑徽章 */
.badge-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.badge-progress {
  font-size: var(--text-caption);
  color: var(--gray);
  font-family: var(--font-hand);
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.badge-cell {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: var(--space-sm) 0;
  border: var(--border-width) solid var(--border-color);
  border-radius: 10rpx 18rpx 12rpx 16rpx;
  background: var(--white);
  box-sizing: border-box;
  transition: transform var(--transition-fast);
}

.badge-cell:active {
  transform: rotate(-1deg);
}

.badge-locked {
  border-style: dashed;
  opacity: 0.35;
}

.badge-emoji {
  font-size: 44rpx;
}

.badge-name {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.badge-target {
  font-size: 18rpx;
  color: var(--gray);
  font-family: var(--font-hand);
}

.badge-question {
  font-weight: 700;
  color: var(--gray);
}

/* 徽章详情卡片 */
.badge-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(58, 58, 58, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.badge-modal {
  position: relative;
  width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xl) var(--space-lg);
  background-color: var(--white);
  border: var(--border-width-lg) solid var(--border-color);
  border-radius: 10rpx 36rpx 18rpx 30rpx;
  box-sizing: border-box;
}

.badge-modal::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 14rpx 34rpx 22rpx 28rpx;
  pointer-events: none;
  opacity: 0.1;
}

.badge-modal-emoji {
  font-size: 96rpx;
  transform: rotate(-3deg);
}

.badge-modal-name {
  font-size: var(--text-h2);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
}

.badge-modal-desc {
  font-size: var(--text-body);
  color: var(--gray);
  font-family: var(--font-hand);
  text-align: center;
  line-height: 44rpx;
}

.badge-modal-status {
  font-size: var(--text-caption);
  font-weight: 700;
  color: var(--orange);
  font-family: var(--font-hand);
  margin-top: var(--space-xs);
}

.badge-modal-btn {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  margin-top: var(--space-md);
}

/* 菜单区 */
.menu-list {
  border-top: 4rpx dashed var(--border-color);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-sm);
  border-bottom: 4rpx dashed #ddd;
}

.menu-item:active {
  background: var(--cream);
}

.menu-title {
  font-size: var(--text-body);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.menu-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gray);
  font-family: var(--font-hand);
  border: 3rpx solid var(--gray);
  border-radius: 10rpx 6rpx 12rpx 8rpx;
  padding: 2rpx 10rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--light-gray);
  font-family: var(--font-hand);
}

/* 底部 slogan */
.profile-slogan {
  display: flex;
  justify-content: center;
  padding: var(--space-lg) 0;
}
