/* 识别结果页样式（手账风格） */

.result-page {
  padding-bottom: var(--space-xxl);
}

/* 用户照片（正方形大图）
   页面内容宽 = 750rpx - 左右各 40rpx 内边距 = 670rpx，高取同值即为正方形 */
.photo-single-img {
  height: 670rpx;
}

.photo-img,
.photo-placeholder {
  width: 100%;
  border: var(--border-width) solid var(--border-color);
  border-radius: 8rpx 28rpx 12rpx 22rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.photo-placeholder-life {
  background: linear-gradient(135deg, #e8f5e9 0%, #d4edda 100%);
  transform: rotate(-1deg);
}

.photo-emoji {
  font-size: 72rpx;
}

/* 照片占位中的相机手绘图标 */
.photo-placeholder-icon {
  width: 30%;
  height: 30%;
}

/* 物种名称区 */
.species-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-sm);
}

.species-name {
  font-size: var(--text-h1);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
  transform-origin: left center;
}

.species-latin {
  font-size: var(--text-body);
  color: var(--gray);
  font-style: italic;
  font-family: var(--font-hand);
}

/* 信息卡片 */
.info-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.info-title {
  font-size: var(--text-h4);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.info-text {
  font-size: var(--text-body);
  line-height: 44rpx;
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 底部操作区 */
.result-actions {
  display: flex;
  gap: var(--space-md);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}

/* 提示条（低置信度 / 菌类参考） */
.notice-bar {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border: var(--border-width) solid var(--orange);
  border-radius: var(--radius-md);
  background-color: var(--orange-bg);
  transform: rotate(-0.5deg);
  margin-bottom: var(--space-md);
}

.notice-text {
  font-size: var(--text-caption);
  color: var(--orange);
  font-weight: 700;
  font-family: var(--font-hand);
  line-height: 36rpx;
}

.notice-actions {
  display: flex;
  gap: var(--space-lg);
}

.notice-link {
  font-size: var(--text-caption);
  color: var(--pencil);
  font-weight: 700;
  font-family: var(--font-hand);
  text-decoration: underline;
}

/* 手动搜索来源提示条（冰蓝） */
.notice-bar-blue {
  border-color: var(--blue);
  background-color: var(--blue-bg);
}

.notice-text-blue {
  color: var(--blue);
}

/* 其他可能候选区 */
.alternatives {
  border: var(--border-width) dashed var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--space-sm) var(--space-md);
}

.alternatives-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alternatives-title {
  font-size: var(--text-h4);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
}

.alternatives-arrow {
  font-size: var(--text-caption);
  color: var(--gray);
}

.alternatives-list {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-sm);
}

.alternative-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-top: 2rpx dashed var(--cream);
}

.alternative-item:active {
  opacity: 0.7;
}

.alternative-name {
  font-size: var(--text-body);
  color: var(--pencil);
  font-weight: 700;
  font-family: var(--font-hand);
}

.alternative-confidence {
  font-size: var(--text-small);
  color: var(--gray);
  font-family: var(--font-hand);
}

/* 识别失败态 */
.result-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.failed-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-xl);
  border: var(--border-width) dashed var(--border-color);
  border-radius: var(--radius-lg);
  width: 100%;
  box-sizing: border-box;
}

.failed-icon {
  font-size: 96rpx;
  transform: rotate(-3deg);
}

/* 识别失败态放大镜手绘图标 */
.failed-icon-img {
  width: 150rpx;
  height: 150rpx;
  transform: rotate(-3deg);
}

.failed-title {
  font-size: var(--text-h2);
  font-weight: 700;
  color: var(--pencil);
  font-family: var(--font-hand);
  transform: rotate(-0.5deg);
}

.failed-desc {
  font-size: var(--text-body);
  color: var(--gray);
  font-family: var(--font-hand);
  text-align: center;
  line-height: 44rpx;
}

.failed-actions {
  display: flex;
  gap: var(--space-md);
  width: 100%;
  margin-top: var(--space-md);
}
