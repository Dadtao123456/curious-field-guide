{
  "description": "好奇图鉴 - 自然生物识别与个人图鉴收集工具",
  "cloudfunctionRoot": "cloudfunctions/",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "project.private.config.json"
      }
    ]
  },
  "setting": {
    "bundle": false,
    "userConfirmedBundleSwitch": false,
    "urlCheck": true,
    "scopeDataCheck": false,
    "coverView": true,
